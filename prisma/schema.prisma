generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ==================== AUTENTICAÇÃO ====================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("TECNICO") // ADMIN, COMERCIAL, LOGISTICA, FINANCEIRO, RH, TECNICO, CONSULTA
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  transportGuides TransportGuide[]
}

// ==================== RECURSOS HUMANOS ====================

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  nif          String?
  address      String?
  position     String   // TECNICO_VIDEO, TECNICO_SOM, TECNICO_ILUMINACAO, TECNICO_ESTRUTURAS, MOTORISTA, GESTOR, ADMIN
  department   String?  // VIDEO, SOM, ILUMINACAO, ESTRUTURAS, TRANSPORTES, ADMINISTRACAO
  hourlyRate   Float    @default(0)
  dailyRate    Float    @default(0)
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)
  status       String   @default("ATIVO") // ATIVO, FERIAS, FOLGA, BAIXA, DESATIVADO
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  epis            EmployeeEPI[]
  certifications  EmployeeCertification[]
  contracts       EmployeeContract[]
  projects        ProjectEmployee[]
  transportGuides TransportGuide[]
  timesheets      TimeSheet[]
  absences        Absence[]
}

model EmployeeEPI {
  id          String   @id @default(cuid())
  employeeId  String
  epiType     String   // CAPACETE, LUVAS, BOTAS, ARNES, PROTETOR_AUDITIVO, COLETE, OCULOS, OUTRO
  description String
  serialNumber String?
  deliveredAt DateTime @default(now())
  expiryDate  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeCertification {
  id           String   @id @default(cuid())
  employeeId   String
  name         String   // EX: CERTIFICADO_TRABALHO_ALTURA, FORMACAO_SEGURANCA, CARTA_CONDUCAO
  issuingEntity String?
  issueDate    DateTime
  expiryDate   DateTime?
  documentUrl  String?
  notes        String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeContract {
  id          String   @id @default(cuid())
  employeeId  String
  type        String   // SEM_PRAZO, PRAZO_CERTO, PARCIAL, PRESTACAO_SERVICOS, ESTAGIO
  startDate   DateTime
  endDate     DateTime?
  salary      Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ==================== DEPARTAMENTOS & FUNÇÕES ====================

model Department {
  id   String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
}

model Position {
  id   String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
}

// ==================== CLIENTS ====================

model Client {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("CLIENTE") // CLIENTE, FORNECEDOR, ENTIDADE
  companyName String?
  email       String?
  phone       String?
  nif         String?
  address     String?
  city        String?
  postalCode  String?
  country     String   @default("Portugal")
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]
  quotations  Quotation[]
  invoices    Invoice[]
  orderNotes  OrderNote[] @relation("OrderNoteSupplier")
}

// ==================== INVENTÁRIO / STOCK ====================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  equipment   Equipment[]
}

model Equipment {
  id                String   @id @default(cuid())
  name              String
  sku               String   @unique // Código único de referência
  description       String?
  categoryId        String?
  brand             String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  purchasePrice     Float    @default(0)
  rentalPriceDaily  Float    @default(0)
  rentalPriceWeekly Float    @default(0)
  quantity          Int      @default(1)
  minStock          Int      @default(0)
  unit              String   @default("UN") // UN, KG, M, M2, L, PAR
  status            String   @default("DISPONIVEL") // DISPONIVEL, ALUGADO, EM_REPARACAO, ABATIDO, EXTRAVIADO
  powerWatts        Float?
  weightKg          Float?
  dimensions        String?
  active            Boolean  @default(true)
  notes             String?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category         Category?          @relation(fields: [categoryId], references: [id])
  attributes       EquipmentAttribute[]
  stockMovements   StockMovement[]
  projectEquipment  ProjectEquipment[]
  repairItems      RepairItem[]
  transportItems   TransportItem[]
}

model EquipmentAttribute {
  id          String  @id @default(cuid())
  equipmentId String
  key         String  // ex: Cor, Potência, Tipo de conector
  value       String

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  location String?
  active   Boolean @default(true)

  stockMovementsFrom StockMovement[] @relation("SourceWarehouse")
  stockMovementsTo   StockMovement[] @relation("DestWarehouse")
}

model StockMovement {
  id                    String   @id @default(cuid())
  equipmentId           String
  type                  String   // ENTRADA, SAIDA, TRANSFERENCIA, AVARIA, REPARACAO_CONCLUIDA
  quantity              Int
  sourceWarehouseId     String?
  destinationWarehouseId String?
  projectId             String?
  userId                String
  notes                 String?
  createdAt             DateTime @default(now())

  equipment          Equipment  @relation(fields: [equipmentId], references: [id])
  sourceWarehouse    Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("DestWarehouse", fields: [destinationWarehouseId], references: [id])
  project            Project?   @relation(fields: [projectId], references: [id])
  user               User       @relation(fields: [userId], references: [id])
}

// ==================== SERVIÇOS ====================

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String   // VIDEO, SOM, ILUMINACAO, ESTRUTURAS, MOBILIARIO, TRANSPORTE, MONTAGEM, OUTRO
  defaultPrice Float    @default(0)
  unit         String   @default("UN") // UN, HORA, DIA, SERVICO, KM
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectServices  ProjectService[]
}

// ==================== PROJETOS / EVENTOS ====================

model Project {
  id          String   @id @default(cuid())
  name        String
  number      String   @unique // PROJ-2026-0001
  clientId    String?
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("RASCUNHO") // RASCUNHO, ORCAMENTADO, CONFIRMADO, EM_CURSO, CONCLUIDO, CANCELADO
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client           Client?            @relation(fields: [clientId], references: [id])
  equipment        ProjectEquipment[]
  services         ProjectService[]
  employees        ProjectEmployee[]
  quotations       Quotation[]
  invoices         Invoice[]
  stockMovements   StockMovement[]
  transportGuides  TransportGuide[]
  timesheets       TimeSheet[]
}

model ProjectEquipment {
  id            String @id @default(cuid())
  projectId     String
  equipmentId   String
  quantity      Int    @default(1)
  priceOverride Float? // Preço diferente do default se aplicável
  notes         String?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])
}

model ProjectService {
  id            String @id @default(cuid())
  projectId     String
  serviceId     String
  quantity      Int    @default(1)
  priceOverride Float?
  notes         String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}

model ProjectEmployee {
  id             String @id @default(cuid())
  projectId      String
  employeeId     String
  role           String? // Função específica no evento
  hours          Float  @default(0)
  rateOverride   Float? // Preço/hora diferente do default
  notes          String?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
}

// ==================== ORÇAMENTOS ====================

model Quotation {
  id          String   @id @default(cuid())
  number      String   @unique // PR_0001-2026
  projectId   String?
  clientId    String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  date        DateTime @default(now())
  validUntil  DateTime?
  subtotal    Float    @default(0)
  taxRate     Float    @default(23)
  taxAmount   Float    @default(0)
  discount    Float    @default(0)
  total       Float    @default(0)
  status      String   @default("RASCUNHO") // RASCUNHO, ENVIADO, ACEITE, RECUSADO, EXPIRADO
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project?        @relation(fields: [projectId], references: [id])
  client  Client?         @relation(fields: [clientId], references: [id])
  items   QuotationItem[]
  invoice Invoice?
}

model QuotationItem {
  id           String  @id @default(cuid())
  quotationId  String
  type         String  // EQUIPAMENTO, SERVICO, MAO_OBRA
  referenceId  String? // ID do equipamento, serviço, ou funcionário
  description  String
  quantity     Int     @default(1)
  unitPrice    Float   @default(0)
  taxRate      Float   @default(23)
  total        Float   @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ==================== FATURAS ====================

model Invoice {
  id           String   @id @default(cuid())
    number          String?  @unique // FAT-2026-0001
  quotationId  String?  @unique
  projectId    String?
  clientId     String?
  date         DateTime @default(now())
  dueDate      DateTime?
  subtotal     Float    @default(0)
  taxRate      Float    @default(23)
  taxAmount    Float    @default(0)
  total        Float    @default(0)
  status       String   @default("PENDENTE") // PENDENTE, PAGO, VENCIDO, CANCELADO
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotation Quotation? @relation(fields: [quotationId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id])
}

// ==================== GUIAS DE REPARAÇÃO ====================

model RepairGuide {
  id              String   @id @default(cuid())
  number          String   @unique // REP-2026-0001
  description     String?
  status          String   @default("PENDENTE") // PENDENTE, EM_REPARACAO, CONCLUIDO, DEVOLVIDO
  reportedBy      String?
  reportedAt      DateTime @default(now())
  startDate       DateTime?
  endDate         DateTime?
  externalRepairer String?  // Nome da empresa/pessoa externa
  totalCost       Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items RepairItem[]
}

model RepairItem {
  id            String   @id @default(cuid())
  repairGuideId String
  equipmentId   String?
  description   String
  issue         String?
  solution      String?
  cost          Float    @default(0)
  status        String   @default("PENDENTE") // PENDENTE, EM_REPARACAO, CONCLUIDO

  repairGuide RepairGuide @relation(fields: [repairGuideId], references: [id], onDelete: Cascade)
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id])
}

// ==================== TRANSPORTES ====================

model Vehicle {
  id              String   @id @default(cuid())
  number          String?  @unique
  name            String   // Nome descritivo ex: Carrinha Mercedes
  licensePlate    String   @unique
  brand           String?
  model           String?
  year            Int?
  type            String   // LIGEIRO, PESADO, CARRINHA, CAMIAO, EMPILHADOR
  fuelType        String?  // GASOLINA, GASOLEO, ELETRICO, HIBRIDO
  capacityKg      Float?
  capacityM3      Float?
  status          String   @default("DISPONIVEL") // DISPONIVEL, EM_USO, EM_MANUTENCAO, ABATIDO
  insuranceExpiry DateTime?
  inspectionExpiry DateTime?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transportGuides TransportGuide[]
}

model TransportGuide {
  id          String   @id @default(cuid())
  number      String   @unique // TRANS-2026-0001
  projectId   String?
  vehicleId   String?
  driverId    String?
  departureDate DateTime?
  returnDate  DateTime?
  origin      String?
  destination String?
  status      String   @default("PENDENTE") // PENDENTE, EM_TRANSITO, CONCLUIDO, CANCELADO
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project?        @relation(fields: [projectId], references: [id])
  vehicle  Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver   Employee?       @relation(fields: [driverId], references: [id])
  items    TransportItem[]
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdById String
}

model TransportItem {
  id               String @id @default(cuid())
  transportGuideId String
  equipmentId      String?
  description      String?
  quantity         Int    @default(1)
  notes            String?

  transportGuide TransportGuide @relation(fields: [transportGuideId], references: [id], onDelete: Cascade)
  equipment      Equipment?     @relation(fields: [equipmentId], references: [id])
}

// ==================== NOTAS DE ENCOMENDA ====================

model OrderNote {
  id           String   @id @default(cuid())
  number       String   @unique // NE_0001-2026
  supplierId   String?
  department   String?  // AUDIO, ILUMINACAO, VIDEO, ESTRUTURAS, MOBILIARIO, ADMINISTRACAO, etc.
  projectCode  String?  // Código de projeto específico se aplicável
  date         DateTime @default(now())
  status       String   @default("PENDENTE") // PENDENTE, APROVADO, ENCOMENDADO, RECEBIDO, CANCELADO
  subtotal     Float    @default(0)
  taxAmount    Float    @default(0)
  total        Float    @default(0)
  fixedAsset   Boolean  @default(false) // Imobilizado da empresa
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Client?        @relation("OrderNoteSupplier", fields: [supplierId], references: [id])
  items    OrderNoteItem[]
}

model OrderNoteItem {
  id           String  @id @default(cuid())
  orderNoteId  String
  description  String
  quantity     Int     @default(1)
  unitPrice    Float   @default(0)
  taxRate      Float   @default(23)
  taxAmount    Float   @default(0)
  total        Float   @default(0)

  orderNote OrderNote @relation(fields: [orderNoteId], references: [id], onDelete: Cascade)
}

// ==================== DEFINIÇÕES ====================

model CompanyInfo {
  id      String @id @default("default")
  name    String @default("Smartchoice Audiovisuais Lda.")
  address String @default("Rua Francisco Simões Carneiro Nº 4")
  postal  String @default("2700-402 Venda Nova, Amadora")
  phone   String @default("+351 218 688 035")
  email   String @default("geral@smartchoice.pt")
  nif     String @default("506219240")
  website String @default("smartchoice.pt")
}

// ==================== PORTAL DO TÉCNICO ====================

model TimeSheet {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  startTime  String   // HH:mm
  endTime    String   // HH:mm
  projectId  String?
  hours      Float    @default(0)
  notes      String?
  status     String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])
}

model Absence {
  id         String   @id @default(cuid())
  employeeId String
  type       String   // FERIAS, FALTA_JUSTIFICADA, FALTA_INJUSTIFICADA, BAIXA, FOLGA
  startDate  DateTime
  endDate    DateTime
  notes      String?
  status     String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
